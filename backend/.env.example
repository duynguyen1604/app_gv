# ==============================================================================
# CẤU HÌNH BACKEND SERVER (KHÔNG ĐƯA LÊN TRÌNH DUYỆT)
# ==============================================================================
PORT=4000
TZ=Asia/Ho_Chi_Minh
FRONTEND_URL=http://localhost:5173

# 1. PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_gv
DB_USER=postgres
DB_PASSWORD=postgres

# 2. Tài khoản Quản trị viên duy nhất (CHỈ ĐẶT Ở SERVER, KHÔNG ĐẶT Ở FRONTEND)
# Tài khoản có email ĐÃ XÁC MINH trùng với ADMIN_EMAIL sẽ tự động nhận role='admin', status='active'
ADMIN_EMAIL=admin@lichday.vn
AUTH_JWT_SECRET=thay-bang-chuoi-bi-mat-ngau-nhien-32-ky-tu

# 3. Supabase Auth (Gói miễn phí - Khóa bí mật chỉ nằm ở Server)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# 4. Dịch vụ gửi thư tiếng Việt (Resend hoặc SMTP riêng - KHÔNG dùng email mặc định giới hạn thấp của Supabase)
RESEND_API_KEY=re_xxxxxxxxx
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxx
SMTP_FROM="Lịch Dạy Giáo Viên <noreply@yourdomain.vn>"

# 5. Google OAuth (Redirect flow cho Đăng nhập & Đồng bộ Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gcal/callback

# 6. Cloudflare Turnstile & Gemini AI
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GEMINI_API_KEY=

